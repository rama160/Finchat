    "tail": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261005.1",
    "@types/node": "^22.15.0",
    "eslint": "^9.30.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "wrangler": "4.147.0",
    "typescript-eslint": "^8.35.0"
  },
  "dependencies": {
    "jose": "^6.1.0"
  }
}

