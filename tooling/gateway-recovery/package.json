{
  "name": "finchat-ai-gateway",
  "version": "0.1.1",
  "private": true,
  "description": "FinChat AI Gateway with Google authentication, rate limiting, quota, model fallback and monitoring.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
